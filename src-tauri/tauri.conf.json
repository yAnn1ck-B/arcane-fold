{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eternal League",
  "version": "0.2.0",
  "identifier": "com.eternalleague.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eternal League",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 700,
        "backgroundColor": "#f1f0ea"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Your local MTG Forge collection companion",
    "category": "Game"
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QzA0RkVEQzQ0NTRBNTIKUldSU1NrWEU3VS9BRkRIWFhESm1jcCtJaXFESzBDNEk2ejRad3ZUWVR4eENqZWc1OFJoMVVxdW8K",
      "endpoints": [
        "https://github.com/yAnn1ck-B/eternal-league/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "sql": {
      "preload": [
        "sqlite:eternal-league.db"
      ]
    }
  }
}
