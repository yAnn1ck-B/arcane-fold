{
  "name": "arcane-fold",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "start": "npm run web:start",
    "web:build": "tsc -b && npm run web:manual && vite build --config vite.web.config.ts",
    "web:manual": "esbuild src/game/remote-manual.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-web-server/manual.mjs",
    "preweb:test": "npm run web:manual",
    "web:start": "node --env-file-if-exists=.env.web web/server.mjs",
    "web:db": "node --env-file-if-exists=.env.web web/setup-db.mjs",
    "web:catalog": "node --env-file-if-exists=.env.web web/catalog.mjs",
    "web:test": "node --env-file-if-exists=.env.web --test web",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "test": "node scripts/native-test.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "test:release": "node --test scripts/release-version.test.mjs scripts/verify-release.test.mjs scripts/migration-policy.test.mjs",
    "test:updater": "node --test scripts/updater.test.mjs",
    "test:decks": "node --test scripts/deck-autosave.test.mjs",
    "test:game": "node --test scripts/game-engine.test.mjs scripts/game-session.test.mjs",
    "test:forge": "node scripts/native-test.mjs --locked --lib real_forge -- --ignored --test-threads=2",
    "release:sign": "node scripts/release-sign.mjs",
    "release:attach": "node scripts/release-attach.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
