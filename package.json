{
  "name": "arcane-fold",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.web web/server.mjs",
    "dev": "npm run build && npm start",
    "build": "tsc -b && npm run web:manual && vite build",
    "test": "npm run web:test && npm run test:decks && npm run test:game",
    "web:build": "npm run build",
    "web:manual": "esbuild src/game/remote-manual.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-web-server/manual.mjs",
    "preweb:test": "npm run web:manual",
    "web:start": "npm start",
    "web:db": "node --env-file-if-exists=.env.web web/setup-db.mjs",
    "web:catalog": "node --env-file-if-exists=.env.web web/catalog.mjs",
    "web:test": "cd web && node --env-file-if-exists=../.env.web --test",
    "test:decks": "node --test scripts/deck-autosave.test.mjs",
    "test:game": "node --test scripts/game-engine.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
